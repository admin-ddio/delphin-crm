# Delphin CRM: the single entry point for humans and CI.
# Everything runs in containers; the host needs Docker (Compose v2), GNU make and bash.

SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

COMPOSE ?= docker compose
PROD    := $(COMPOSE) -f compose.yaml -f compose.prod.yaml
BE      := $(COMPOSE) run --rm -T backend
BE_NODB := $(COMPOSE) run --rm -T --no-deps backend
FE      := $(COMPOSE) run --rm -T --no-deps frontend

UV_IMAGE   := ghcr.io/astral-sh/uv:0.8-python3.12-bookworm-slim
NODE_IMAGE := node:22-alpine
GITLEAKS_IMAGE := zricethezav/gitleaks:v8.28.0

.PHONY: help env lock up down logs ps migrate migrate-check makemigration seed-config \
        gen-api gen-api-check lint format typecheck test test-backend test-frontend e2e dev-user \
        check build prod-up prod-down secrets-scan clean

help: ## List targets
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | sort | \
	  awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

env: ## Create .env from .env.example if missing
	@test -f .env || { cp .env.example .env && echo "created .env: replace the change-me values"; }

lock: ## (Re)generate backend/uv.lock and frontend/pnpm-lock.yaml
	docker run --rm -v "$(CURDIR)/backend:/src" -w /src $(UV_IMAGE) uv lock
	docker run --rm -v "$(CURDIR)/frontend:/src" -w /src $(NODE_IMAGE) \
	  sh -c "npm i -g pnpm@10.17.0 >/dev/null && pnpm install --lockfile-only"

up: env ## Build and start the dev stack (http://localhost:5173)
	$(COMPOSE) up -d --build --renew-anon-volumes --wait

down: ## Stop the stack
	$(COMPOSE) down --remove-orphans

logs: ## Follow logs
	$(COMPOSE) logs -f --tail=200

ps: ## Show service status
	$(COMPOSE) ps

migrate: ## Apply migrations (alembic upgrade head)
	$(COMPOSE) run --rm migrate

migrate-check: ## Fail if models and migrations have drifted (alembic check)
	$(BE) alembic check

makemigration: ## New autogenerated revision: make makemigration name=add_clients
	@test -n "$(name)" || { echo "usage: make makemigration name=<slug>"; exit 1; }
	$(BE) alembic revision --autogenerate -m "$(name)"

seed-config: ## Upsert the permission catalogue and default roles (no business data)
	$(BE) python scripts/seed_config.py

gen-api: ## Regenerate frontend/src/api/schema.d.ts from the backend OpenAPI schema
	$(BE_NODB) python scripts/export_openapi.py > frontend/src/api/openapi.json
	$(FE) pnpm gen-api

gen-api-check: gen-api ## Fail if the committed schema.d.ts is stale
	git diff --exit-code -- frontend/src/api/schema.d.ts

lint: ## ruff, import-linter, eslint, prettier --check
	$(BE_NODB) sh -c "ruff check . && ruff format --check . && lint-imports"
	$(FE) sh -c "pnpm lint && pnpm format:check"

format: ## Auto-format backend and frontend
	$(BE_NODB) sh -c "ruff check --fix . && ruff format ."
	$(FE) pnpm format

typecheck: ## mypy --strict, tsc
	$(BE_NODB) mypy
	$(FE) pnpm typecheck

test-backend: ## pytest (unit + contract + integration against the test DB)
	$(BE) pytest

test-frontend: ## vitest
	$(FE) pnpm test

test: test-backend test-frontend ## All unit/integration tests

E2E_EMAIL ?= e2e@example.com
E2E_PASSWORD ?= e2e-password-not-secret

e2e: ## Playwright on an isolated throw-away stack (never touches your dev data)
	E2E_RUNNER=$(or $(E2E_RUNNER),container) E2E_EMAIL=$(E2E_EMAIL) E2E_PASSWORD='$(E2E_PASSWORD)' \
	  bash infra/e2e/run.sh

dev-user: ## Local sign-in: make dev-user email=you@example.com name="You" role=super_admin password=…
	@test -n "$(email)" -a -n "$(password)" || { echo 'usage: make dev-user email=… password=… [name=… role=…]'; exit 1; }
	$(BE) python scripts/dev_create_user.py $(email) "$(or $(name),Dev User)" $(or $(role),super_admin) '$(password)'

check: lint typecheck test migrate-check ## Everything CI runs before e2e

build: ## Build all images (dev and prod targets)
	$(COMPOSE) build
	$(PROD) build

prod-up: env ## Production profile: nginx edge on http://localhost:8080
	$(PROD) up -d --build --wait

prod-down: ## Stop the production profile
	$(PROD) down --remove-orphans

secrets-scan: ## gitleaks over the working tree and history
	docker run --rm -v "$(CURDIR):/repo" $(GITLEAKS_IMAGE) detect --source /repo --redact -v

clean: ## Stop everything, delete volumes and build output
	$(COMPOSE) --profile e2e down -v --remove-orphans
	$(PROD) down -v --remove-orphans
	rm -rf frontend/dist frontend/coverage frontend/playwright-report frontend/test-results \
	  frontend/src/api/openapi.json backend/.pytest_cache backend/.mypy_cache backend/.ruff_cache \
	  backend/.coverage backend/htmlcov
