# ---------------------------------------------------------------------------
# Delphin CRM: environment configuration
# Copy to .env (git-ignored) and replace every "change-me" value.
# Compose fails loudly (${VAR:?}) when a required variable is missing.
# ---------------------------------------------------------------------------

# Compose project name (container and volume prefix)
COMPOSE_PROJECT_NAME=delphin-crm

# development | test | production
# production enforces strong secrets, disables CORS and hides /api/docs.
APP_ENV=development

# Public base URL of the SPA, used in e-mailed links (activation, reset).
APP_BASE_URL=http://localhost:5173

# --- PostgreSQL (required) --------------------------------------------------
POSTGRES_DB=delphin
POSTGRES_USER=delphin
POSTGRES_PASSWORD=change-me

# --- Secrets (required) -----------------------------------------------------
# Generate with: openssl rand -hex 32
# production refuses values shorter than 32 chars or containing "change-me".
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Bearer token for POST /api/v1/jobs/run (external cron).
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- HTTP -------------------------------------------------------------------
# Comma-separated Host header allow-list (TrustedHostMiddleware).
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated origins. Dev only; must be empty in production (same-origin via nginx).
CORS_ORIGINS=
# Serve /api/docs and /api/v1/openapi.json in production.
EXPOSE_DOCS=false
# Maximum request body size in bytes (default 10 MiB).
MAX_REQUEST_BODY_BYTES=10485760

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_HOURS=12

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Firebase Auth (identity provider) -------------------------------------
# Firebase holds passwords and sends verification / reset e-mails; the backend
# verifies Firebase ID tokens and opens its own session (docs/adr/0009).
#
# Development defaults use the local Auth Emulator (docker compose service
# "firebase"); "demo-*" project IDs never contact Google.
# Production: set your real project ID and web config, leave
# FIREBASE_AUTH_EMULATOR_HOST empty, set VITE_FIREBASE_USE_EMULATOR=false and
# point GOOGLE_APPLICATION_CREDENTIALS at a mounted service-account JSON
# (needed to create users / invitation links; sign-in only needs the project ID).
FIREBASE_PROJECT_ID=demo-delphin
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_APPLICATION_CREDENTIALS=
# Web app config (Firebase console > Project settings > Your apps). Public values.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATOR=true
